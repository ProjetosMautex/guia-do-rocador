---
import { Header } from '../components/Header';
import { RocadeiraEletricaOuGasolina } from '../components/roçadeiras/RocadeiraEletricaOuGasolina';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuprocadeira';
import '../styles/global.css';

const title = "Roçadeira Elétrica ou a Gasolina: Qual Escolher? | Guia do Roçador";
const description = "Roçadeira elétrica ou a gasolina? Compare potência (Watts vs. cc), autonomia, custo de manutenção e veja a tabela por tamanho de terreno para acertar na compra.";
const canonicalUrl = "https://guiadorocador.com.br/rocadeira-eletrica-ou-a-gasolina";
const ogImage = "/images/blog/rocadeira-eletrica-ou-a-gasolina-bancada.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />

    <main class="flex-grow">
      <RocadeiraEletricaOuGasolina client:idle />
    </main>

    <Footer />

    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
