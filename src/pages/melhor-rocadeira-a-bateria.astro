---
import { Header } from '../components/Header';
import { MelhorRocadeiraABateria } from '../components/roçadeiras/MelhorRocadeiraABateria';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuprocadeira';
import '../styles/global.css';

const title = "Melhor Roçadeira a Bateria em 2026: Top 11 Modelos | Guia do Roçador";
const description = "Qual a melhor roçadeira a bateria em 2026? Análise técnica de 11 modelos (Bosch, Makita, STIHL, Toyama e mais) com foco em torque, autonomia e durabilidade!";
const canonicalUrl = "https://guiadorocador.com.br/melhor-rocadeira-a-bateria";
const ogImage = "/images/blog/melhor-rocadeira-a-bateria.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />

    <main class="flex-grow">
      <MelhorRocadeiraABateria client:idle />
    </main>

    <Footer />

    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
