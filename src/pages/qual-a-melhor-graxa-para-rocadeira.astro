---
import { Header } from '../components/Header';
import { QualAMelhorGraxaParaRocadeira } from '../components/roçadeiras/QualAMelhorGraxaParaRocadeira';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuprocadeira';
import '../styles/global.css';

const title = "Melhor Graxa para Roçadeira: Qual Usar na Ponteira e Transmissão | Guia do Roçador";
const description = "Qual a melhor graxa para roçadeira? Compare as graxas de lítio Stihl e Husqvarna (80g) e aprenda como lubrificar a ponteira e a transmissão sem superaquecer.";
const canonicalUrl = "https://guiadorocador.com.br/qual-a-melhor-graxa-para-rocadeira";
const ogImage = "/images/blog/qual-a-melhor-graxa-para-rocadeira.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />

    <main class="flex-grow">
      <QualAMelhorGraxaParaRocadeira client:idle />
    </main>

    <Footer />

    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
