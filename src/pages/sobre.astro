---
import { Header } from '../components/Header';
import { About } from '../components/About';
import { Footer } from '../components/Footer';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuprocadeira';
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Sobre Nós | Guia do Roçador - Ferramentas de Jardinagem e Áreas Verdes</title>
    <meta name="description" content="Conheça o Guia do Roçador, seu portal especializado em ferramentas de jardinagem e equipamentos para o cuidado e manutenção de áreas verdes." />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />
    <main class="flex-grow">
      <About />
    </main>
    <Footer />
    
    <ExitIntentPopup client:load />
  </body>
</html>
