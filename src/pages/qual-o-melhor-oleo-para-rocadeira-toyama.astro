---
import { Header } from '../components/Header';
import { MelhorOleoRocadeiraToyama } from '../components/roçadeiras/MelhorOleoRocadeiraToyama';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopupoleo2tempos as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopupoleo2tempos';
import '../styles/global.css';

const title = "Qual o Melhor Óleo para Roçadeira Toyama? Top 4 Opções (2T e 4T) | Guia do Roçador";
const description = "Qual o melhor óleo para roçadeira Toyama (2T e 4T)? Confira as 4 melhores opções, a proporção exata da mistura (50:1 e 25:1) e evite fundir o motor!";
const canonicalUrl = "https://guiadorocador.com.br/qual-o-melhor-oleo-para-rocadeira-toyama";
const ogImage = "/images/blog/qual-o-melhor-oleo-para-rocadeira-toyama.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />

    <main class="flex-grow">
      <MelhorOleoRocadeiraToyama client:idle />
    </main>

    <Footer />

    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
