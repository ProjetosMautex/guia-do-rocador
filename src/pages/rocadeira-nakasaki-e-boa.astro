---
import { Header } from '../components/Header';
import { RocadeiraNakasakiEBoa } from '../components/roçadeiras/RocadeiraNakasakiEBoa';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuprocadeira';
import '../styles/global.css';

const title = "Roçadeira Nakasaki é Boa? [Review de 3 Modelos em 2026] | Guia do Roçador";
const description = "Roçadeira Nakasaki é boa mesmo? Analisamos potência real, durabilidade e custo-benefício dos modelos 65cc, 75cc e Costal para chácaras e sítios em 2026!";
const canonicalUrl = "https://guiadorocador.com.br/rocadeira-nakasaki-e-boa";
const ogImage = "/images/blog/Roçadeira Gasolina Profissional Nakasaki 2t 75cc Com Trimmer.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content="Roçadeira Nakasaki é Boa? [Review de 3 Modelos em 2026]" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />

    <main class="flex-grow">
      <RocadeiraNakasakiEBoa client:idle />
    </main>

    <Footer />

    <CookieConsent client:idle />
    <ExitIntentPopup client:idle />
  </body>
</html>
