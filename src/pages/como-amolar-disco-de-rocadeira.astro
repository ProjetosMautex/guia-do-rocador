---
import { Header } from '../components/Header';
import { ComoAmolarDiscoRocadeira } from '../components/roçadeiras/ComoAmolarDiscoRocadeira';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopuplaminadeorocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuplaminadeorocadeira';
import '../styles/global.css';

const title = "Como Amolar Disco de Roçadeira: Passo a Passo Seguro (Aço e Vídea) | Guia do Roçador";
const description = "Aprenda como amolar disco de roçadeira (aço e vídea) passo a passo com segurança. Veja qual lima usar, como evitar vibração no balanceamento e dicas práticas de campo!";
const canonicalUrl = "https://guiadorocador.com.br/como-amolar-disco-de-rocadeira";
const ogImage = "/images/blog/como-amolar-disco-de-rocadeira.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />

    <main class="flex-grow">
      <ComoAmolarDiscoRocadeira client:idle />
    </main>

    <Footer />

    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
