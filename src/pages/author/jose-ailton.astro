---
import { Header } from '../../components/Header';
import { AuthorJoseAilton } from '../../components/autores/AuthorJoseAilton';
import { Footer } from '../../components/Footer';
import { CookieConsent } from '../../components/CookieConsent';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../../components/roçadeiras/ExitIntentPopuprocadeira';
import '../../styles/global.css';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>José Ailton da Silva | Especialista Operacional em Roçadeiras | Guia do Roçador</title>
    <meta name="description" content="Conheça José Ailton da Silva, especialista e operador de roçadeiras com mais de 10 anos de experiência prática diária em corte no campo e vegetação densa." />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />
    
    <main class="flex-grow">
      {/* client:load is important here for interactive elements and scroll intent to function */}
      <AuthorJoseAilton client:load />
    </main>
    
    <Footer />
    
    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
