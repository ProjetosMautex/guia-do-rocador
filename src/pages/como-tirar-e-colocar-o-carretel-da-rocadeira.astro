---
import { Header } from '../components/Header';
import { ComoTirarEColocarCarretelRocadeira } from '../components/roçadeiras/ComoTirarEColocarCarretelRocadeira';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopupfiodenylonpararocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopupfiodenylonpararocadeira';
import '../styles/global.css';

const title = "Como Tirar e Colocar o Carretel da Roçadeira: Passo a Passo | Guia do Roçador";
const description = "Aprenda como tirar e colocar o carretel da roçadeira sem estragar a rosca esquerda, como destravar cabeçote emperrado e conferir a arruela de encosto no eixo.";
const canonicalUrl = "https://guiadorocador.com.br/como-tirar-e-colocar-o-carretel-da-rocadeira";
const ogImage = "/images/blog/como-tirar-e-colocar-o-carretel-da-rocadeira.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />

    <main class="flex-grow">
      <ComoTirarEColocarCarretelRocadeira client:idle />
    </main>

    <Footer />

    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
