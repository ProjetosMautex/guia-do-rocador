---
import { Header } from '../components/Header';
import { TamanhoFioNylonRocadeira } from '../components/roçadeiras/TamanhoFioNylonRocadeira';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuprocadeira';
import '../styles/global.css';

const title = "Tamanho do Fio de Nylon para Roçadeira: Espessura e Como Escolher | Guia do Roçador";
const description = "Qual o tamanho do fio de nylon para roçadeira ideal? Veja a tabela de espessura (1,6 mm a 3,3 mm), ponta certa de 15 a 20 cm, metragem por carretel e hidratação 24h.";
const canonicalUrl = "https://guiadorocador.com.br/qual-o-tamanho-do-fio-de-nylon-para-rocadeira";
const ogImage = "/images/blog/qual-o-tamanho-do-fio-de-nylon-para-rocadeira.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />

    <main class="flex-grow">
      <TamanhoFioNylonRocadeira client:idle />
    </main>

    <Footer />

    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
