---
import { Header } from '../components/Header';
import { ComoMontarRocadeiraNakasaki } from '../components/roçadeiras/ComoMontarRocadeiraNakasaki';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuprocadeira';
import '../styles/global.css';

const title = "Como Montar Roçadeira Nakasaki: Guia Prático da Haste e Motor | Guia do Roçador";
const description = "Como montar roçadeira Nakasaki 63cc, 65cc e 75cc na ordem certa de bancada: lado do tubo bipartido, aperto da embreagem em X, guidão, saia e ponteira.";
const canonicalUrl = "https://guiadorocador.com.br/como-montar-rocadeira-nakasaki";
const ogImage = "/images/blog/como-montar-rocadeira-nakasaki.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />
    
    <main class="flex-grow">
      <ComoMontarRocadeiraNakasaki client:idle />
    </main>
    
    <Footer />
    
    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
