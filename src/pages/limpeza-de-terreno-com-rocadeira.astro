---
import { Header } from '../components/Header';
import { LimpezaTerrenoComRocadeira } from '../components/roçadeiras/LimpezaTerrenoComRocadeira';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuprocadeira';
import '../styles/global.css';

const title = "Limpeza de Terreno com Roçadeira: Passo a Passo Seguro | Guia do Roçador";
const description = "Aprenda como fazer a limpeza de terreno com roçadeira e como limpar quintal com muito mato passo a passo: escolha entre nylon e lâmina, corte em 2 alturas e EPIs.";
const canonicalUrl = "https://guiadorocador.com.br/limpeza-de-terreno-com-rocadeira";
const ogImage = "/images/blog/limpeza-de-terreno-com-rocadeira.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />

    <main class="flex-grow">
      <LimpezaTerrenoComRocadeira client:idle />
    </main>

    <Footer />

    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
