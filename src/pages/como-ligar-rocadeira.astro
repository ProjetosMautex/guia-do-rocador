---
import { Header } from '../components/Header';
import { ComoLigarRocadeira } from '../components/roçadeiras/ComoLigarRocadeira';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuprocadeira';
import '../styles/global.css';

const title = "Como Ligar Roçadeira a Gasolina (Motor Frio): Passo a Passo | Guia do Roçador";
const description = "Aprenda como ligar roçadeira a gasolina com motor frio sem afogar: quantas vezes apertar o primer, hora exata de abrir o afogador e tabela de partida a frio vs. quente.";
const canonicalUrl = "https://guiadorocador.com.br/como-ligar-rocadeira";
const ogImage = "/images/blog/como-ligar-rocadeira-principal.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
    <link rel="canonical" href={canonicalUrl} />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />
    
    <main class="flex-grow">
      <ComoLigarRocadeira client:idle />
    </main>
    
    <Footer />
    
    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
