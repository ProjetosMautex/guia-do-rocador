---
import { Header } from '../components/Header';
import { RocadeiraToyamaRt52lEBoa } from '../components/roçadeiras/RocadeiraToyamaRt52lEBoa';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuprocadeira';
import '../styles/global.css';

const title = "Roçadeira Toyama RT52L é Boa? Análise e Vale a Pena (2026) | Guia do Roçador";
const description = "A roçadeira Toyama RT52L é boa? Analisamos o motor de 51,7cc e 2 HP, ficha técnica do manual, manutenção e custo-benefício para decidir se vale o investimento.";
const canonicalUrl = "https://guiadorocador.com.br/rocadeira-toyama-rt52l-e-boa";
const ogImage = "/images/blog/rocadeira-toyama-rt52l-e-boa.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />

    <main class="flex-grow">
      <RocadeiraToyamaRt52lEBoa client:idle />
    </main>

    <Footer />

    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
