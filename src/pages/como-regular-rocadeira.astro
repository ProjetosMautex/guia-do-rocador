---
import { Header } from '../components/Header';
import { ComoRegularRocadeira } from '../components/roçadeiras/ComoRegularRocadeira';
import { Footer } from '../components/Footer';
import { CookieConsent } from '../components/CookieConsent';
import { ExitIntentPopuprocadeira as ExitIntentPopup } from '../components/roçadeiras/ExitIntentPopuprocadeira';
import '../styles/global.css';

const title = "Como Regular Roçadeira e Carburador (Stihl FS 160, 220, FS 80, Toyama) | Guia do Roçador";
const description = "Roçadeira falhando ou morrendo na lenta? Aprenda como regular o carburador da roçadeira (agulhas L, H e LA) passo a passo nos modelos Stihl FS 220, FS 160, FS 80 e Toyama.";
const canonicalUrl = "https://guiadorocador.com.br/como-regular-rocadeira";
const ogImage = "/images/blog/1/como regular roçadeira.webp";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen m-0 w-full antialiased text-[#1a1a1a]">
    <Header client:load />
    
    <main class="flex-grow">
      <ComoRegularRocadeira client:idle />
    </main>
    
    <Footer />
    
    <CookieConsent client:load />
    <ExitIntentPopup client:load />
  </body>
</html>
